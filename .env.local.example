# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ AI CANVAS
# ============================================================
# Скопируйте этот файл в .env.local и заполните значениями.
# В Next.js-проекте файл .env.local НЕ коммитится в Git.
# ============================================================

# ------------------------------------------------------------
# ЯНДЕКС ID (OAuth 2.0)
# ------------------------------------------------------------
# Регистрация приложения: https://oauth.yandex.ru
# 
# Настройки в консоли Яндекс OAuth:
#   Платформа: Веб-сервисы
#   Callback URL:
#     - http://localhost:3000/api/auth/yandex/callback (для разработки)
#     - https://your-project.vercel.app/api/auth/yandex/callback (для продакшена)
#   Хостнейм (Hostname):
#     - localhost:3000 (для разработки)
#     - your-project.vercel.app (для продакшена Vercel)
#   Доступы (Scopes):
#     - login:email
#     - login:info
#     - login:avatar
#
YANDEX_CLIENT_ID=your_yandex_client_id_here
YANDEX_CLIENT_SECRET=your_yandex_client_secret_here
YANDEX_REDIRECT_URI=http://localhost:3000/api/auth/yandex/callback

# ------------------------------------------------------------
# JWT СЕКРЕТ (для подписи сессионных токенов)
# ------------------------------------------------------------
# Сгенерируйте случайную строку (минимум 32 символа):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
JWT_SECRET=your_jwt_secret_minimum_32_characters_long_here

# ------------------------------------------------------------
# SBER GIGACHAT API
# ------------------------------------------------------------
# Регистрация: https://developers.sber.ru/studio/workspaces
# 
# 1. Создайте проект в GigaChat API Studio
# 2. Получите Client ID (Authorization Key) и Client Secret (Secret Key)
# 3. Для продакшена нужен сертификат НУЦ Минцифры (для доверия к API)
#
# Для разработки можно использовать самоподписанный сертификат:
#   NODE_TLS_REJECT_UNAUTHORIZED=0 (НЕ для продакшена!)
#
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret_here
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# ------------------------------------------------------------
# ОБЩЕЕ
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
