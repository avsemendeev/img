# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ AI CANVAS
# ============================================================
# Скопируйте этот файл в .env.local и заполните значениями.
# ============================================================

# ------------------------------------------------------------
# ЯНДЕКС ID (OAuth 2.0)
# ------------------------------------------------------------
# Регистрация приложения: https://oauth.yandex.ru
# 
# Настройки в консоли Яндекс OAuth:
#   Платформа: Веб-сервисы
#   Redirect URI:
#     - http://localhost:3000/ (для разработки)
#     - https://your-project.vercel.app/ (для продакшена)
#   Доступы (Scopes):
#     - login:email
#     - login:info
#     - login:avatar
#
# ВАЖНО: Используйте VITE_ префикс для переменных, доступных на клиенте
VITE_YANDEX_CLIENT_ID=your_yandex_client_id_here

# ------------------------------------------------------------
# SBER GIGACHAT API (для генерации изображений)
# ------------------------------------------------------------
# Регистрация: https://developers.sber.ru/studio/workspaces
# 
# Для разработки можно использовать демо-режим без реальных ключей
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret_here
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# ------------------------------------------------------------
# ОБЩЕЕ
# ------------------------------------------------------------
NODE_ENV=development
