# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ AI CANVAS
# ============================================================
# Скопируйте этот файл в .env.local и заполните значениями.
# В Next.js-проекте файл .env.local НЕ коммитится в Git.
# ============================================================

# ------------------------------------------------------------
# ЯНДЕКС ID (OAuth 2.0)
# ------------------------------------------------------------
# Регистрация приложения: https://oauth.yandex.ru
# 
# Настройки в консоли Яндекс OAuth:
#   Платформа: Веб-сервисы
#   Redirect URI: https://your-project.vercel.app/
#   Доступы (Scopes):
#     - login:email
#     - login:info
#     - login:avatar
#
VITE_YANDEX_CLIENT_ID=your_yandex_client_id_here
VITE_YANDEX_REDIRECT_URI=https://your-project.vercel.app/

# ------------------------------------------------------------
# SBER GIGACHAT API (для генерации изображений)
# ------------------------------------------------------------
# Регистрация: https://developers.sber.ru/studio/workspaces
# 
# 1. Создайте проект GigaChat API в Studio
# 2. В разделе "Настройки API" нажмите "Получить ключ"
# 3. Скопируйте Authorization Key, Client ID и Client Secret
# 4. Вставьте Client ID и Client Secret ниже
#
# Важно: API требует сертификаты НУЦ Минцифры для работы
# https://developers.sber.ru/docs/ru/gigachat/certificates
#
GIGACHAT_CLIENT_ID=your_gigachat_client_id_here
GIGACHAT_CLIENT_SECRET=your_gigachat_client_secret_here

# ------------------------------------------------------------
# ОБЩЕЕ
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
