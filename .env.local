# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ AI CANVAS
# ============================================================
# Заполните этот файл своими ключами API
# ============================================================

# ------------------------------------------------------------
# ЯНДЕКС ID (OAuth 2.0)
# ------------------------------------------------------------
# Получите Client ID на https://oauth.yandex.ru
# Redirect URI должен быть: http://localhost:3000/ (для разработки)
YANDEX_CLIENT_ID=

# ------------------------------------------------------------
# SBER GIGACHAT API (опционально, для генерации изображений)
# ------------------------------------------------------------
# Получите ключи на https://developers.sber.ru/studio/workspaces
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_AUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions
