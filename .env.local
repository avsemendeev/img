# ============================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ AI CANVAS
# ============================================================
# Заполните этот файл своими ключами API
# ============================================================

# ------------------------------------------------------------
# ЯНДЕКС ID (OAuth 2.0)
# ------------------------------------------------------------
# Получите Client ID на https://oauth.yandex.ru
# Redirect URI: https://img-ten-orcin.vercel.app/
VITE_YANDEX_CLIENT_ID=
VITE_YANDEX_REDIRECT_URI=https://img-ten-orcin.vercel.app/

# ------------------------------------------------------------
# SBER GIGACHAT API (для генерации изображений)
# ------------------------------------------------------------
# Получите ключи на https://developers.sber.ru/studio/workspaces
# 1. Создайте проект GigaChat API
# 2. В настройках API получите Authorization Key
# 3. Извлеките Client ID и Client Secret из Authorization Key
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
